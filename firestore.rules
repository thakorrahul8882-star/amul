rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'thakorrahul8882@gmail.com'
      );
    }

    // Connection test rule
    match /test/{docId} {
      allow read: if true;
    }

    // Categories: public read & management for store admin
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Products: public read, ordering stock adjustments & admin inventory management
    match /products/{productId} {
      allow read, write: if true;
    }

    // Store settings: public read & store settings update
    match /storeSettings/{docId} {
      allow read, write: if true;
    }

    // Orders: Customer creation and status tracking; Admin order fulfillment
    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
